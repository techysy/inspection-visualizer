# Inspection Visualizer 地址
IV_URL=http://127.0.0.1:5001

# 登录凭据
# 方式一：留空 IV_USERNAME，IV_PASSWORD 填 .env 里的 APP_PASSWORD
# 方式二：填巡检人员的 username + password
IV_USERNAME=
IV_PASSWORD=

# 写入记录时使用的巡检人名称
IV_INSPECTOR_NAME=CSV 自动巡检

# 区域聚合粒度
#   leaf  末级区域（中江县/东江公园 -> 东江公园），默认
#   root  顶级区域（-> 中江县）
#   full  完整路径（-> 中江县/东江公园）
#   both  末级 + 顶级各写一条
AREA_MODE=leaf

LOG_LEVEL=INFO
