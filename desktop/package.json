{
  "name": "inspection-visualizer-desktop",
  "productName": "InspectionVisualizer",
  "version": "1.0.0",
  "description": "巡检数据可视化 桌面托盘版 — Electron 托盘壳 + Python sidecar",
  "main": "main.js",
  "author": "techysy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.techysy.inspection-visualizer",
    "productName": "InspectionVisualizer",
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "package.json",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "build/app",
        "to": "app"
      },
      {
        "from": "build/python",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "InspectionVisualizer-${version}-${arch}.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InspectionVisualizer"
    },
    "portable": {
      "artifactName": "InspectionVisualizer-Portable-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
